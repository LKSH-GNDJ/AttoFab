<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.attofab.app"
    android:versionCode="1"
    android:versionName="0.1.0">

    <!-- AttoFab is GPU-bound (SVO raymarching via wgpu/Vulkan); require a
         reasonably current API level and OpenGL ES 3.2 / Vulkan support. -->
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />
    <uses-feature android:glEsVersion="0x00030002" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version" android:required="false" />

    <application
        android:label="AttoFab"
        android:hasCode="true"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- android_activity's glue expects a NativeActivity pointed at the
             cdylib produced by this crate (libapp_android.so), with
             android_main (see src/lib.rs) as its entry point. -->
        <activity
            android:name="android.app.NativeActivity"
            android:label="AttoFab"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:exported="true"
            android:screenOrientation="landscape">
            <meta-data android:name="android.app.lib_name" android:value="app_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
